<UserControl x:Class="StockSharp.Samples.Foundation.TradingWorkstation.Views.SimpleConnectorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="15">
            <StackPanel>
                <TextBlock Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                           Text="Connector Management" Margin="0,0,0,10"/>

                <WrapPanel>
                    <Button x:Name="SettingsBtn"
                            Content="Settings"
                            Click="SettingsClick"
                            Width="120" Height="35" Margin="5"
                            Style="{DynamicResource MaterialDesignRaisedButton}"/>

                    <Button x:Name="ConnectBtn"
                            Content="Connect"
                            Click="ConnectClick"
                            Width="120" Height="35" Margin="5"
                            Style="{DynamicResource MaterialDesignRaisedButton}"/>

                    <Button x:Name="TestBtn"
                            Content="Test Connection"
                            Click="TestClick"
                            Width="120" Height="35" Margin="5"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"/>

                    <Button x:Name="DisconnectBtn"
                            Content="Disconnect"
                            Click="DisconnectClick"
                            Width="120" Height="35" Margin="5"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"/>
                </WrapPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Main Content -->
        <materialDesign:Card Grid.Row="2" Margin="10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                               Text="Available Connectors" Margin="0,0,0,10"/>

                    <!-- Connector Selection ComboBox -->
                    <ComboBox x:Name="ConnectorSelector"
                            Margin="0,0,0,10"
                            SelectionChanged="ConnectorSelector_OnSelectionChanged"
                            materialDesign:HintAssist.Hint="Select connector type"
                            Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Type"/>

                    <TextBlock Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                               Text="Account Name:" Margin="0,0,0,5"/>
                    <TextBox x:Name="AccountNameTextBox"
                             Margin="0,0,0,10"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Enter account name"/>

                    <Button x:Name="AddAccountBtn"
                            Content="Add Account"
                            Click="AddAccountClick"
                            Width="150" Height="35"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Margin="0,0,0,10"/>

                    <!-- Account Status Display -->
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                     Text="Selected Account:" Margin="0,0,0,5"/>
                            <TextBlock x:Name="SelectedAccountText"
                                     Text="None selected"
                                     Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                     Text="Status:" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusIndicator"
                                       Width="12" Height="12"
                                       Fill="Gray"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText"
                                         Text="Disconnected"
                                         Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Configured Accounts List -->
                    <TextBlock Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                               Text="Configured Accounts" Margin="0,20,0,10"/>
                    <ListBox x:Name="AccountsList"
                           Height="150"
                           SelectionChanged="AccountsList_OnSelectionChanged"
                           Style="{DynamicResource MaterialDesignListBox}"/>
                </StackPanel>

                <!-- Right Panel -->
                <StackPanel Grid.Column="2" Margin="20,0,0,0">
                    <TextBlock Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                               Text="Configuration" Margin="0,0,0,10"/>

                    <!-- Configuration display -->
                    <TextBlock Style="{DynamicResource MaterialDesignBody1TextBlock}"
                               Text="Configuration:" Margin="0,0,0,5"/>
                    <TextBox x:Name="SettingsDisplay"
                            Height="200"
                            Margin="0,0,0,10"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap"
                            Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Selected account configuration will appear here"
                            Text="Select an account to view configuration"/>

                    <!-- Activity Log -->
                    <TextBlock Style="{DynamicResource MaterialDesignBody1TextBlock}"
                               Text="Activity Log (Session Only):" Margin="0,10,0,5"/>
                    <TextBox x:Name="ActivityLog"
                            Height="150"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap"
                            Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Activity entries will appear here"
                            Text="[12:00:00] Session started&#x0a;[12:00:01] Connector discovery service initialized&#x0a;[12:00:02] Ready for connector management&#x0a;[12:00:03] Available connectors: Bitstamp, Binance, Interactive Brokers"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>