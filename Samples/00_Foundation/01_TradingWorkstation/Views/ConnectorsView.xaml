<UserControl x:Class="StockSharp.Samples.Foundation.TradingWorkstation.Views.ConnectorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="ConnectorsView_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Connector Management Controls (adapted from MultiConnect MainPanel) -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="15">
            <StackPanel>
                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Text="Connector Management" Margin="0,0,0,10"/>

                <WrapPanel>
                    <Button x:Name="SettingsBtn"
                            Content="Settings"
                            Click="SettingsClick"
                            Width="120" Height="35" Margin="5"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>

                    <Button x:Name="ConnectBtn"
                            Content="Connect"
                            Click="ConnectClick"
                            Width="120" Height="35" Margin="5"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>

                    <Button x:Name="TestConnectionBtn"
                            Content="Test Connection"
                            Click="TestConnectionClick"
                            Width="120" Height="35" Margin="5"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>

                    <Button x:Name="RefreshBtn"
                            Content="Refresh"
                            Click="RefreshClick"
                            Width="120" Height="35" Margin="5"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </WrapPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Connector Details (adapted for connector-focused UI) -->
        <materialDesign:Card Grid.Row="2" Margin="10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Available Connectors List -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Available Connectors" Margin="0,0,0,10"/>

                    <!-- Connector Selection ComboBox -->
                    <ComboBox x:Name="ConnectorSelector"
                            Margin="0,0,0,10"
                            SelectionChanged="ConnectorSelector_OnSelectionChanged"
                            materialDesign:HintAssist.Hint="Select connector type"
                            Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Type"/>

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="Account Name:" Margin="0,0,0,5"/>
                    <TextBox x:Name="AccountNameTextBox"
                             materialDesign:HintAssist.Hint="Enter account name"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,10"/>

                    <Button x:Name="AddAccountBtn"
                            Content="Add Account"
                            Click="AddAccountClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,0,10"/>

                    <!-- Account List -->
                    <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Configured Accounts" Margin="0,10,0,5"/>
                    <ListBox x:Name="AccountsList"
                             SelectionChanged="AccountsList_OnSelectionChanged"
                             Height="200"/>
                </StackPanel>

                <!-- Configuration Panel -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Configuration &amp; Status" Margin="0,0,0,10"/>

                    <!-- Status Display -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                            CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Ellipse x:Name="StatusIndicator" Width="12" Height="12"
                                        Fill="Gray" Margin="0,0,10,0"/>
                                <TextBlock x:Name="StatusText" Text="Disconnected"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Account:" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock x:Name="SelectedAccountText" Text="None selected"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Configuration display -->
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Configuration:" Margin="0,0,0,5"/>
                    <TextBox x:Name="SettingsDisplay"
                            Height="200"
                            Margin="0,0,0,10"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap"
                            Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Selected account configuration will appear here"/>

                    <!-- Activity Log -->
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Activity Log (Session Only):" Margin="0,10,0,5"/>
                    <TextBox x:Name="ActivityLog"
                            Height="150"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap"
                            Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Activity entries will appear here"
                            Text="Session started&#x0a;Connector discovery service initialized&#x0a;Ready for connector management"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>